# ── MT5 credentials (leave blank if MT5 is already open and logged in) ────────
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ── Instrument ─────────────────────────────────────────────────────────────────
# Single symbol per bot instance. Run multiple instances for multiple symbols.
SYMBOL=XAUUSD
TIMEFRAME=M1

# ── Scanner interval (seconds between scans) ───────────────────────────────────
SCAN_INTERVAL=60

# ── Execution Mode ─────────────────────────────────────────────────────────────
# false = auto-execute (mirrors InpManualConfirm=false in MQL5 EA)
# true  = manual confirmation prompt before each order
MANUAL_CONFIRM=false

# ── Risk Management ────────────────────────────────────────────────────────────
RISK_PERCENT=0.15        # % of account balance risked per trade
MIN_RR=0                 # minimum R:R ratio (0 = disabled)
MAX_LOTS=7.0             # hard cap on position size regardless of risk calc

# ── Strategy Parameters ────────────────────────────────────────────────────────
CANDLE_COUNT=20          # historical bars to analyse
BIG_X_MOVE_PCT=0.5       # X% impulse move that defines the peak
                         #   Forex: 1-2%  |  Indices: 2-4%  |  Crypto: 5%+
Y_MAX_PCT=600.0          # Y% max distance (minor pt → peak) as % of X move
                         #   hard-capped at 90% at runtime; set high to effectively disable
TP_MULTIPLIER=0.5        # TP = this% × (midpoint → minor point distance)

# ── Pullback Strength Gates ────────────────────────────────────────────────────
MIN_IMPULSE_PIPS=5.0     # minimum peak→minor distance in pips
MIN_PULLBACK_PCT=2.0     # min pullback retracement % of peak→minor distance
MAX_PULLBACK_PCT=70.0    # max pullback retracement % (deeper = weakening trend)

# ── ICT Session Filter (Rule 8) ────────────────────────────────────────────────
USE_SESSION=false        # false = trade 24hrs | true = ICT sessions only
GMT_OFFSET=0             # broker server offset from GMT (e.g. +2 for EET)
ASIAN_START_H=23         # 23:00 GMT = 1hr before Tokyo open
ASIAN_END_H=9            # 09:00 GMT = Tokyo/Sydney close
LONDON_START_H=7         # 07:00 GMT = 1hr pre-London
LONDON_END_H=16          # 16:00 GMT = London close
NY_START_H=12            # 12:00 GMT ≈ 1hr pre-NY
NY_END_H=17              # 17:00 GMT = NY AM session end

# ── Post-TP Cooldown (Rule 9) ──────────────────────────────────────────────────
USE_POST_TP_COOLDOWN=true
POST_TP_COOLDOWN_MINS=20

# ── Big Move Cooldown Filter (Rule 7) ──────────────────────────────────────────
USE_BIG_MOVE_COOLDOWN=true
BIG_MOVE_PCT=1.0         # single-bar move >= this % triggers cooldown
BIG_MOVE_COOLDOWN_BARS=20

# ── Key Level Filter (Rule 7) ──────────────────────────────────────────────────
USE_KEY_LEVEL=true
KEY_LEVEL_PIPS=10.0      # proximity buffer around ATH/ATL, W1/MN1 pivots (pips)

# ── Trade Settings ─────────────────────────────────────────────────────────────
MAGIC_NUMBER=20260412
SLIPPAGE=20
